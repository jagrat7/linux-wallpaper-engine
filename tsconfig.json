{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.*.config.ts",
    "vite.*.config.mts",
    "vite.config.mts",
    "scripts/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/renderer/*"],
      "~/*": ["./src/renderer/*"]
    }
  }
}
